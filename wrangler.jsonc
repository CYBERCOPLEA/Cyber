// Cloudflare Worker for SudarshanAshtra. Cloudflare builds this automatically from the main branch (npx wrangler deploy).
// The Worker (worker/index.js) is the door: users sign in with their tool User ID + password; the Super Admin page needs Cloudflare Access.
{
  "name": "sudarshanashtra",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // keep the Google script address as a Secret in the Cloudflare dashboard, never here
  "keep_vars": true
}
