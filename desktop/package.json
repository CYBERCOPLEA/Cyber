{
  "name": "sudarshanashtra-desktop",
  "productName": "SudarshanAshtra",
  "version": "1.0.1",
  "description": "SudarshanAshtra \u2013 Cyber Crime Analysis & Tracking (offline desktop edition)",
  "author": "Vijay Tomar",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-app": "node scripts/prepare.js",
    "start": "node scripts/prepare.js && electron .",
    "dist": "node scripts/prepare.js && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.1",
    "resedit": "2.0.3"
  },
  "build": {
    "appId": "in.sudarshanashtra.desktop",
    "productName": "SudarshanAshtra",
    "copyright": "Developer: Vijay Tomar",
    "artifactName": "SudarshanAshtra-Setup-${version}.exe",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "SudarshanAshtra",
      "uninstallDisplayName": "SudarshanAshtra",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "afterPack": "scripts/afterpack.js",
    "publish": null,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "hi"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CYBERCOPLEA/SudarshanAshtra.git"
  }
}
